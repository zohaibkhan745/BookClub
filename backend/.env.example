# Supabase PostgreSQL connection
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Environment (development, testing, production, serverless)
ENV=development

# Frontend URL (for CORS in production)
FRONTEND_URL=http://localhost:3000

# Supabase Auth Settings
# Get these from your Supabase project: Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret-here
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Cloudflare R2 Storage (Optional for cover uploads)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=books-images
R2_PUBLIC_DOMAIN=https://images.yourdomain.com

# Admin Security Key (required for bulk administrative actions)
ADMIN_SECRET_KEY=your-admin-secret-key-here
